# NABD Frontend Environment Variables

# Local Development only — copy this to .env.local and fill in:
# NEXT_PUBLIC_NABD_API=http://127.0.0.1:8040/api

# Production (Render Docker unified deployment):
# Leave NEXT_PUBLIC_NABD_API unset — the app uses /api by default (same domain).
NEXT_PUBLIC_NABD_API=

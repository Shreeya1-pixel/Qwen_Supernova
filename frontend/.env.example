# NABD Frontend Environment Variables

# Backend API URL.
# Local Development: defaults automatically to http://127.0.0.1:8040/api
# Render Production (2-Service setup): Set to your Render backend API URL, e.g.:
# NEXT_PUBLIC_NABD_API=https://qwen-supernova-api.onrender.com/api
NEXT_PUBLIC_NABD_API=

# Optional: If running frontend as a Next.js Node server and reverse-proxying API calls
# NABD_BACKEND_URL=https://qwen-supernova-api.onrender.com
